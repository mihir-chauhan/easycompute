/**
 * LabContextExtractor state of a lab (id = lab id): the cached LLM extraction of the current context text (reused while
 * the text hash is unchanged) and the set the lab confirmed ({@link Advisor#confirmConstraints}). Extracted fields stay
 * unconfirmed until the lab confirms them for that exact text.
 */
entity type Advisor.ConstraintSet {

  /**
   * Hash of the context text that was parsed.
   */
  textHash: string

  /**
   * The structured constraints as JSON text.
   */
  result: string

  /**
   * `llm` or `rules`.
   */
  source: string

  /**
   * When the text was parsed.
   */
  parsedAt: datetime

  /**
   * Hash of the context text the lab confirmed; the confirmation applies only while the text is unchanged.
   */
  confirmedHash: string

  /**
   * The constraints the lab confirmed (possibly edited), validated, as JSON text.
   */
  confirmedResult: string

  /**
   * When the lab confirmed the constraints.
   */
  confirmedAt: datetime
}
