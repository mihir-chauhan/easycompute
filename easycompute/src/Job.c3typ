/**
 * A Slurm job: historical (from sacct, pseudonymized) or live (simulated, {@link Job#isLive}). Id is
 * `<clusterId>-<slurmJobId>`. Inherited `name` is unused; {@link Job#jobName} is the Slurm job name.
 */
@db(index=['lab', 'cluster', 'partition', 'state', 'isLive', 'user', 'workloadType', 'gpuType', 'submitTime', 'lab, submitTime'])
entity type Job {

  /**
   * Slurm JobID.
   */
  slurmJobId: string

  /**
   * Lab that ran the job (mapped from the Slurm account).
   */
  lab: Lab

  /**
   * Project the job belongs to.
   */
  project: Project

  /**
   * Planner request the job was submitted from.
   */
  runRequest: RunRequest

  /**
   * Pseudonymized username.
   */
  user: string

  /**
   * Cluster.
   */
  cluster: ComputeCluster

  /**
   * Partition.
   */
  partition: Partition

  /**
   * Slurm account charged.
   */
  account: string

  /**
   * Slurm QOS.
   */
  qos: string

  /**
   * Slurm job name.
   */
  jobName: string

  /**
   * Kind of work.
   */
  workloadType: string enum WorkloadType

  /**
   * Slurm state.
   */
  state: string enum Job.State

  /**
   * Submit time.
   */
  submitTime: datetime

  /**
   * Start time.
   */
  startTime: datetime

  /**
   * End time.
   */
  endTime: datetime

  /**
   * Time limit in hours.
   */
  timelimitHours: double

  /**
   * Elapsed run time in hours.
   */
  elapsedHours: double

  /**
   * Allocated CPU cores.
   */
  allocCpus: int

  /**
   * Allocated nodes.
   */
  allocNodes: int

  /**
   * Allocated GPUs.
   */
  allocGpus: int

  /**
   * GPU type.
   */
  gpuType: GpuType

  /**
   * Requested memory in GB.
   */
  reqMemGb: double

  /**
   * Peak resident memory in GB.
   */
  maxRssGb: double

  /**
   * CPU efficiency (0-1): total CPU time / (cores x elapsed).
   */
  cpuEfficiency: double

  /**
   * Memory efficiency (0-1): MaxRSS / requested.
   */
  memEfficiency: double

  /**
   * Average GPU utilization (0-100).
   */
  gpuUtilAvg: double

  /**
   * Cost in the cluster allocation unit.
   */
  costUnits: double

  /**
   * Cost in USD.
   */
  costUsd: double

  /**
   * Slurm exit code ("0:0").
   */
  exitCode: string

  /**
   * Allocated nodes.
   */
  nodeList: string

  /**
   * True for simulated currently running or pending jobs.
   */
  isLive: boolean

  /**
   * GPU-hours used (allocated GPUs x elapsed hours).
   */
  gpuHours: double calc "allocGpus * elapsedHours"

  /**
   * GPU-hours allocated but not used (GPU-hours x idle fraction).
   */
  wastedGpuHours: double calc "exists(gpuUtilAvg) ? allocGpus * elapsedHours * (100 - gpuUtilAvg) / 100 : 0"

  /**
   * Resource-usage samples.
   */
  metrics: [JobMetric](job)

  /**
   * Health alerts.
   */
  alerts: [JobAlert](job)

  /**
   * Actions taken on the job.
   */
  actions: [ActionLogEntry](job)

  /**
   * Applies the health rules (idle or low GPU, OOM, walltime, budget, hung, node failure, preemption, stale
   * checkpoint) to the latest metric window, opens, refreshes or auto-resolves {@link JobAlert} rows and returns the
   * active alerts, most severe first.
   */
  evaluateHealth: member function(): [JobAlert] js-server

  /**
   * Applies an {@link ActionType} to the job as the given {@link ActionLogEntry.Actor} (cancel, extend walltime,
   * requeue to standby, checkpoint, scale down, notify PI, hold), resolves the alerts it addresses and logs it.
   */
  applyAction: member function(actionType: !string, actor: !string): ActionLogEntry js-server
}
