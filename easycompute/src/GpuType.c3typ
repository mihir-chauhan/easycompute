/**
 * A GPU model available on Purdue and cloud clusters. Id is the model key (for example "A100-80GB"); inherited
 * `name` is the display name.
 */
entity type GpuType {

  /**
   * GPU vendor.
   */
  vendor: string

  /**
   * GPU memory in GB.
   */
  memoryGb: int

  /**
   * Peak dense FP16/BF16 tensor TFLOPS.
   */
  fp16Tflops: double

  /**
   * Training throughput relative to A100-40GB (= 1.0).
   */
  relativeThroughput: double

  /**
   * Reference third-party (cloud) price per GPU-hour in USD.
   */
  costPerGpuHourUsd: double
}
