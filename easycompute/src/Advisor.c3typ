/**
 * Server side of PolicyRAGAdvisor and LabContextExtractor. PolicyRAGAdvisor is a {@link GenaiCore.Agent.LangChain}
 * agent (Agent Gallery, category "Research Computing") that answers questions about a lab with retrieval over a
 * versioned set of Purdue RCAC / NSF ACCESS policy documents, the Policy rows, the lab context and projects, plus live
 * job evidence, through the read-only tool methods below (wrapped as {@link GenaiCore.Tool.C3Method}). Every answer cites
 * its sources. It explains; it never submits, cancels or overrides rules: answers end with deep links to the Launch
 * planner and run pages, where the user acts. LabContextExtractor turns the lab context text into schema-validated
 * constraints with evidence spans that stay unconfirmed until the lab confirms them.
 */
type Advisor {

  /**
   * Creates the tools of the agent and the agent, or a new agent version when its prompt, model or tools changed.
   * Idempotent: when the latest version already matches, nothing is written.
   *
   * @param publish If true, also publishes the agent into this package (dev mode only) so other environments get it.
   * @return the id of the latest {@link GenaiCore.Agent} version named "EasyCompute Advisor".
   */
  ensureAgent: function(publish: boolean): !string py

  /**
   * Asks the advisor a question about a lab and waits for the answer. Falls back to the deterministic offline advisor
   * when the LLM agent is unavailable, so the page always gets an answer.
   *
   * @param question  The question of the user.
   * @param sessionId Conversation id from a previous {@link Advisor.Reply#sessionId}; empty starts a new conversation.
   * @param labId     The lab the user is looking at (header lab switcher); given to the agent as context.
   * @param mode      `agent` (default) or `offline` to skip the LLM and use the deterministic advisor.
   * @return the answer with inline [id] citations, the tools it used, the cited sources and next-step deep links.
   */
  ask: function(question: !string, sessionId: string, labId: string, mode: string): !Advisor.Reply py

  /**
   * LabContextExtractor: parses the free-text context of a lab into schema-constrained constraints with the platform LLM
   * client, merged onto the rules-based parse and validated against the schema and the text. Every item carries
   * `evidence: {quote, start, end}` (an exact substring of the text and its character offsets); invalid items are
   * dropped and listed in `validation.errors`. Status is UNCONFIRMED until the lab confirms ({@link Advisor#confirmConstraints});
   * a confirmed set for the same text is returned as CONFIRMED. LLM results are cached per lab and text.
   *
   * Result: `{component, version, status, source (llm or rules), model, textHash, budgets: [{kind, amount, period,
   * scope, evidence}], deadlines: [{label, date, daysAway, evidence}], preferences: {clusters, gpuTypes, avoid,
   * preemptibleOk, maxWalltimeHours, quietHours, notes, evidence: [{field, value, quote, start, end}]},
   * dataRestrictions: [{kind, description, evidence}], memberCaps: [{who, pct, evidence}], approvals: [{threshold, unit,
   * evidence}], summary, warnings, validation: {valid, errors, dropped}, cached, confirmedAt, llmError}`.
   *
   * @param labId The lab; its contextDump is parsed when text is empty.
   * @param text  Context text to parse instead of the stored contextDump (preview before saving; never cached).
   * @return the structured constraints as JSON.
   */
  extractConstraints: function(labId: string, text: string): json py

  /**
   * LabContextExtractor: the lab confirms (optionally edited) constraints for its current context text. The result is
   * validated (schema + evidence spans; nothing may be dropped) and stored; it stays valid while the text is unchanged.
   *
   * @param labId      The lab.
   * @param resultJson The constraints to confirm as JSON text (as returned by extractConstraints, possibly edited);
   *                   empty confirms the current extraction.
   * @return the confirmed constraints with status CONFIRMED.
   */
  confirmConstraints: function(labId: !string, resultJson: string): json js-server

  /**
   * The confirmed constraints of a lab when they match its current context text, else null. Internal; used by
   * extractConstraints.
   *
   * @param labId The lab.
   * @return confirmed constraints or null.
   */
  confirmedConstraints: function(labId: !string): json js-server

  /**
   * Validates constraints against the LabContextExtractor schema and the source text (evidence spans recomputed,
   * invalid items dropped and reported). Internal; used by extractConstraints for the LLM output.
   *
   * @param resultJson The constraints as JSON text.
   * @param text       The lab text the evidence must quote.
   * @return validated constraints as JSON text.
   */
  validateConstraints: function(resultJson: !string, text: string): !string js-server

  /**
   * Rules-based constraint parser behind {@link Advisor#extractConstraints}; also its fallback when no LLM answers.
   *
   * @param labId The lab; its contextDump is parsed when text is empty.
   * @param text  Context text to parse instead of the stored contextDump.
   * @return the structured constraints as JSON text (same shape as extractConstraints plus inputText).
   */
  parseConstraintsRules: function(labId: string, text: string): !string js-server

  /**
   * Stores a parsed constraint result in the {@link Advisor.ConstraintSet} cache. Internal; called by extractConstraints.
   *
   * @param labId      The lab.
   * @param hash       Hash of the parsed text.
   * @param resultJson The result as JSON text.
   * @param source     `llm` or `rules`.
   * @return true.
   */
  saveConstraints: function(labId: !string, hash: !string, resultJson: !string, source: string): boolean js-server

  /**
   * Agent tool: retrieval over the versioned Purdue RCAC / NSF ACCESS policy documents, the active Policy rules in scope,
   * the lab context sentences and the lab projects. Returns the best passages with citation ids (D-xx documents, Policy
   * ids such as P-01, lab context lab#n, project ids). Call it for any question about rules, limits, QOS, charges,
   * storage, allocations policy or what the lab said, and cite the ids you use as [id].
   *
   * @param query     Words to look up, e.g. preemptible walltime gautschi checkpoint.
   * @param labId     The lab id (adds its rules, context and projects).
   * @param clusterId Optional cluster to focus on: anvil, gilbreth, gautschi, negishi, bell or aws-p4d.
   * @param limit     Number of passages, 1 to 10 (default 6).
   * @return passages with ids, titles, versions, source URLs and text, as JSON text.
   */
  retrieveSources: function(query: !string, labId: string, clusterId: string, limit: int): !string js-server

  /**
   * Agent tool: everything known about one lab. Returns the lab profile, today, every allocation (total, used,
   * remaining units and dollars, end date), every project with its deadline and days left, and the constraints parsed
   * from the lab context dump (budgets, deadlines, cluster and GPU preferences, data restrictions). Call it first for
   * any question about budget, deadlines or what the lab prefers.
   *
   * @param labId The lab id, e.g. as given in the conversation context.
   * @return lab context as JSON text.
   */
  labContext: function(labId: !string): !string js-server

  /**
   * Agent tool: the dashboard numbers of one lab (spend, budget burn, efficiency, wasted GPU-hours, live jobs) from
   * Insights.labSummary.
   *
   * @param labId The lab id.
   * @return lab summary as JSON text.
   */
  labSummary: function(labId: !string): !string js-server

  /**
   * Agent tool: active university, cluster, partition and lab policies (rules) that apply to a lab, optionally only
   * for one cluster or one rule kind.
   *
   * @param labId     The lab id; lab-scoped rules of other labs are left out.
   * @param clusterId Optional cluster: anvil, gilbreth, gautschi, negishi, bell or aws-p4d.
   * @param kind      Optional rule kind: MAX_WALLTIME, MAX_GPUS_PER_JOB, MAX_NODES_PER_JOB, MAX_JOBS_PER_USER,
   *                  ALLOWED_GPU_TYPES, BUDGET_REMAINING, DEADLINE_FEASIBLE, FAIRSHARE_CAP, PREEMPTIBLE_ONLY,
   *                  DATA_RESIDENCY, EXPORT_CONTROL, MIN_GPU_UTIL or QUIET_HOURS.
   * @return matching policies as JSON text.
   */
  listPolicies: function(labId: string, clusterId: string, kind: string): !string js-server

  /**
   * Agent tool: predicted run duration from past jobs (Insights.predictDuration).
   *
   * @param workloadType TRAINING, FINETUNE, INFERENCE, SIMULATION, DATA_PROCESSING or INTERACTIVE.
   * @param gpuTypeId    GPU type id, e.g. A100-40GB or H100-80GB.
   * @param gpus         Number of GPUs.
   * @param modelParamsB Model size in billions of parameters (0 when not a model).
   * @return the prediction as JSON text.
   */
  predictDuration: function(workloadType: string, gpuTypeId: string, gpus: int, modelParamsB: double): !string js-server

  // c3-analysis-disable c3-excessive-method-params -- flat optional filters are easier for an LLM tool caller than a spec object.
  /**
   * Agent tool: what-if check of a planned run. Creates a DRAFT run request (never submitted), runs the rule checks
   * against university, cluster, partition and lab rules plus budget and deadline, and returns the top 3 launch plans
   * (Fastest, Cheapest, Balanced) with cluster, partition, GPUs, walltime, estimated wait, duration, finish time, cost
   * and whether each meets the deadline, plus the remaining allocations. Use it for every "can we finish X by Y",
   * "where should we run", "how much will it cost" question. Every argument except labId is optional.
   *
   * @param labId         The lab id.
   * @param name          Short name of the run.
   * @param description   What the run does, in the words of the user.
   * @param workloadType  TRAINING, FINETUNE, INFERENCE, SIMULATION, DATA_PROCESSING or INTERACTIVE.
   * @param project       Project id or a word of its name or deadline label, e.g. NeurIPS; supplies the deadline.
   * @param gpuTypeId     Requested GPU type id, e.g. A100-40GB or H100-80GB.
   * @param gpus          Requested number of GPUs.
   * @param walltimeHours Requested walltime in hours.
   * @param clusterId     Requested cluster: anvil, gilbreth, gautschi, negishi, bell or aws-p4d.
   * @param modelParamsB  Model size in billions of parameters.
   * @param datasetGb     Dataset size in GB.
   * @param deadline      Deadline as YYYY-MM-DD or a weekday name such as Friday, inclusive (the run may finish any time
   *                      that day, until 23:59 UTC); defaults to the project deadline.
   * @return rule check results, ranked plans and remaining budget as JSON text, including runRequestId and planId values.
   */
  evaluateRun: function(labId: !string, name: string, description: string, workloadType: string, project: string, gpuTypeId: string, gpus: int, walltimeHours: double, clusterId: string, modelParamsB: double, datasetGb: double, deadline: string): !string js-server
  // c3-analysis-enable c3-excessive-method-params

  /**
   * Agent tool: the live (running or pending) jobs of a lab with their latest GPU utilization, GPU memory, checkpoint
   * age, walltime left, cost and open alerts with the recommended action.
   *
   * @param labId The lab id; empty lists live jobs of every lab.
   * @param state Optional job state filter: PENDING or RUNNING.
   * @return live jobs as JSON text.
   */
  liveJobs: function(labId: string, state: string): !string js-server

  /**
   * Agent tool: health of one job. Re-evaluates the health rules, then returns the job, min / avg / max of its last 12
   * metric samples (GPU util, GPU memory, CPU, RAM, checkpoint age, training loss), open alerts, recent actions and the
   * suggested actions.
   *
   * @param jobId The job id as returned by liveJobs.
   * @return job health as JSON text.
   */
  jobHealth: function(jobId: !string): !string js-server

  /**
   * Agent tool: university-wide view from Insights.universityOverview: utilization and cost by cluster and billing
   * type, fairness (share vs usage by lab), idle resources and where more resources are needed.
   *
   * @return the overview as JSON text.
   */
  universityOverview: function(): !string js-server

  /**
   * Starter questions for the Assistant page, personalised with the nearest deadline and open alerts of the lab.
   *
   * @param labId The lab.
   * @return array of question strings.
   */
  suggestedPrompts: function(labId: string): json js-server

  /**
   * Compact facts about a lab (allocations left, next deadlines, live jobs and open alerts, data restrictions) that ask
   * adds to every agent query, so simple budget and deadline questions need no tool call. Internal; not an agent tool.
   *
   * @param labId The lab.
   * @return one line of text, empty when the lab is unknown.
   */
  contextSnapshot: function(labId: string): !string js-server

  /**
   * Server time marking the start of an ask turn. Internal; used by ask to collect the tool calls of the turn.
   *
   * @return ISO timestamp one second before now.
   */
  beginTurn: function(): !string js-server

  /**
   * Tool calls, citations and deep links recorded since a turn started. Internal; used by ask.
   *
   * @param since ISO timestamp from beginTurn.
   * @return JSON text `{toolCalls: [...], citations: [...], links: [...]}`.
   */
  turnTrace: function(since: !string): !string js-server

  /**
   * Deterministic advisor used when the LLM agent is unavailable: routes the question by keywords to the same tools and
   * writes a short markdown answer from their results.
   *
   * @param question The question of the user.
   * @param labId    The lab the user is looking at.
   * @return markdown answer.
   */
  offlineAnswer: function(question: !string, labId: string): !string js-server
}
