/**
 * An action proposed by the EasyCompute Advisor (submit a planned run, or an action on a live job). Nothing happens
 * until the user confirms it on the Assistant page ({@link Advisor#confirmProposal}) or discards it
 * ({@link Advisor#discardProposal}). The inherited `name` holds a one-line summary.
 */
@db(index=['state', 'labId'])
entity type Advisor.Proposal {

  /**
   * SUBMIT_RUN or JOB_ACTION.
   */
  kind: string

  /**
   * Lab the proposal belongs to.
   */
  labId: string

  /**
   * Job to act on (JOB_ACTION).
   */
  jobId: string

  /**
   * Run request to submit (SUBMIT_RUN).
   */
  runRequestId: string

  /**
   * Plan to submit the run request with (SUBMIT_RUN).
   */
  planId: string

  /**
   * ActionType to apply: SUBMIT, CANCEL, EXTEND_WALLTIME, REQUEUE_STANDBY, CHECKPOINT_NOW, SCALE_DOWN, NOTIFY_PI or HOLD.
   */
  actionType: string

  /**
   * Why the advisor proposed it.
   */
  reason: string

  /**
   * JSON text with plan or job details shown on the confirmation card (incl. the sbatch preview for runs).
   */
  details: string

  /**
   * PENDING, APPLIED, FAILED or DISCARDED.
   */
  state: string

  /**
   * Outcome message after the user decided.
   */
  resultText: string

  /**
   * Job created or changed when the proposal was applied.
   */
  resultJobId: string

  /**
   * When the user confirmed or discarded the proposal.
   */
  decidedAt: datetime
}
