/**
 * Lifecycle of a {@link RunRequest} through the planner.
 */
enum type RunRequest.Status {
  /**
   * Described but not yet checked.
   */
  DRAFT = 'DRAFT'
  /**
   * Rules evaluated by {@link RunRequest#checkRules}; at least one compliant option exists.
   */
  CHECKED = 'CHECKED'
  /**
   * Ranked plans generated by {@link RunRequest#recommendPlans}.
   */
  PLANNED = 'PLANNED'
  /**
   * A plan was chosen and the job submitted with {@link RunRequest#submit}.
   */
  SUBMITTED = 'SUBMITTED'
  /**
   * A blocking rule fails for every option, so the run cannot be submitted as described.
   */
  REJECTED = 'REJECTED'
}
