/**
 * Run log of one {@link JobDurationModel#train} call: the {@link MlModel} it created, its {@link MlModel.Route} status,
 * the deterministic 80/20 holdout counts and metrics, and the latest {@link JobDurationModel#scoreLive} pass that used it.
 */
@db(index=['trainedAt', 'modelId'])
entity type JobDurationModel.Run {

  /**
   * Id of the trained {@link MlModel} (platform-generated by {@link MlModel#train}; the untrained template it was
   * trained from is removed).
   */
  modelId: string

  /**
   * {@link MlProject} the model belongs to (`job-duration`).
   */
  projectId: string

  /**
   * Id of the {@link MlModel.Route} the model was deployed on.
   */
  routeId: string

  /**
   * Route status label after promotion (`CHAMPION` on success).
   */
  routeStatus: string

  /**
   * Number of older routes in the project that were set to `RETIRED` by this run.
   */
  retiredRoutes: int

  /**
   * `SUCCEEDED` or `FAILED`.
   */
  status: string

  /**
   * Error text when {@link JobDurationModel.Run#status} is `FAILED`.
   */
  message: string

  /**
   * When training finished.
   */
  trainedAt: datetime

  /**
   * Finished history jobs eligible for training (isLive false, COMPLETED or TIMEOUT, elapsedHours > 0).
   */
  eligibleCount: int

  /**
   * Jobs in the 80% training split.
   */
  trainCount: int

  /**
   * Jobs in the 20% holdout split.
   */
  testCount: int

  /**
   * Holdout mean absolute error of the model, in hours.
   */
  maeHours: double

  /**
   * Holdout coefficient of determination (R2) of the model, on hours.
   */
  r2: double

  /**
   * Holdout MAE in hours of the baseline that predicts the training-set median elapsed hours per workload type.
   */
  baselineMaeHours: double

  /**
   * Holdout R2 of the median-per-workloadType baseline.
   */
  baselineR2: double

  /**
   * Full metrics: model and baseline MAE/R2/median absolute error, per-workloadType baseline medians, hyperparameters,
   * feature set ids and the split rule.
   */
  metrics: json

  /**
   * Time of the last {@link JobDurationModel#scoreLive} pass with this model.
   */
  lastScoredAt: datetime

  /**
   * Number of {@link JobPrediction} rows written by that pass.
   */
  lastScoredCount: int
}
