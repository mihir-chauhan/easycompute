{
  "id": "EasyCompute.LabMember",
  "description": "Lab member (student/staff): reads every EasyCompute type, plans and submits runs, acts on own jobs (lab scope enforced in server methods).",
  "permissions": [
    "allow:GpuType:read:",
    "allow:ComputeCluster:read:",
    "allow:Partition:read:",
    "allow:Lab:read:",
    "allow:LabMember:read:",
    "allow:Allocation:read:",
    "allow:Project:read:",
    "allow:Policy:read:",
    "allow:AutopilotPolicy:read:",
    "allow:RunRequest:read:",
    "allow:RuleCheck:read:",
    "allow:RunPlan:read:",
    "allow:Job:read:",
    "allow:JobMetric:read:",
    "allow:JobAlert:read:",
    "allow:ActionLogEntry:read:",
    "allow:AppUser:read:",
    "allow:Insights::*",
    "allow:Advisor::*",
    "allow:RunRequest::create",
    "allow:RunRequest::merge",
    "allow:RunRequest::checkRules",
    "allow:RunRequest::recommendPlans",
    "allow:RunRequest::submit",
    "allow:Job::applyAction",
    "allow:Job::evaluateHealth",
    "allow:JobAlert::merge",
    "allow:RunMonitor::tick",
    "allow:UserAdmin::whoAmI",
    "allow:UserAdmin::setDemoUser",
